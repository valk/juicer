{
  "autoContinueAtUsageLimit": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/hooks/budget_guard.sh\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "overloaded|server_error",
        "hooks": [
          {
            "type": "command",
            "command": "claude-auto-retry _stopfailure-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
